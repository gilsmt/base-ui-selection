{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "incremental": false,
        "declaration": true,
        "allowImportingTsExtensions": false,
        "removeComments": false,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src"]
}
